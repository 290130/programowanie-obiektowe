#include <iostream>
#include <string>
#include <fstream>
using namespace std;


class ISerializable{
public:
    virtual string serializable() = 0;
    virtual ~ISerializable() {}
};

class Osoba{
private:
    string imie;
    string nazwisko;

public:

    void setImie(string i){
        imie = i;
    }

    void setNazwisko(string n){
        nazwisko = n;
    }

    string getImie(){
        return imie;
    }

    string getNazwisko(){
        return nazwisko;
    }

    virtual void drukuj(){
        cout << "OSOBA: "
             << imie << " "
             << nazwisko << endl;
    }

    virtual ~Osoba() {}
};

class Student :
    public Osoba,
    public ISerializable {

private:
    int indeks;

public:

    Student(){
        indeks = 0;
    }

    void setIndeks(int i){
        if(i >= 100000 && i <= 999999)
            indeks = i;
        else
            cout << "Indeks musi miec 6 cyfr" << endl;
    }

    int getIndeks(){
        return indeks;
    }

    void drukuj() override{
        cout << "STUDENT: " << getImie() << " " << getNazwisko() << " Indeks: " << indeks << endl;
    }

    string serializable() override{
        return "Student;" + getImie() + ";" + getNazwisko() + ";" + to_string(indeks); //zamiana int na string
    }
};

class Pracownik : public Osoba{

private:
    string stanowisko;
    string stopien;

public:

    void setStanowisko(string s){
        stanowisko = s;
    }

    void setStopien(string s){
        stopien = s;
    }

    void drukuj() override{
        cout << "PRACOWNIK: "<< getImie() << " "<< getNazwisko()<< " Stanowisko: "<< stanowisko<< " Stopien: "<< stopien<< endl;
    }
};

int main()
{
    Osoba* tab[10];
    int liczbaOsob = 0;

    while(true)
    {
        int operacja;

        cout << endl;
        cout << "1. Dodaj osobe" << endl;
        cout << "2. Wyswietl liste" << endl;
        cout << "3. Zapisz do pliku" << endl;
        cout << "4. Wyjscie" << endl;
        cout << "Wybor: "<<endl;

        cin >> operacja;

        switch(operacja)
        {

        case 1: //dodawanie
        {
            int status;

            cout << "1. Student" << endl;
            cout << "2. Pracownik" << endl;
            cout << "Wybor: ";

            cin >> status;

            if(liczbaOsob >= 10)
            {
                cout << "Tablica pelna!" << endl;
                break;
            }

            if(status == 1)
            {
                Student* s = new Student;

                string imie;
                string nazwisko;
                int indeks;

                cout << "Imie: ";
                cin >> imie;

                cout << "Nazwisko: ";
                cin >> nazwisko;

                cout << "Indeks: ";
                cin >> indeks;

                s->setImie(imie);
                s->setNazwisko(nazwisko);
                s->setIndeks(indeks);

                tab[liczbaOsob++] = s;
            }

            else if(status == 2)
            {
                Pracownik* p = new Pracownik;

                string imie;
                string nazwisko;
                string stanowisko;
                string stopien;

                cout << "Imie: ";
                cin >> imie;

                cout << "Nazwisko: ";
                cin >> nazwisko;

                cout << "Stanowisko: ";
                cin >> stanowisko;

                cout << "Stopien naukowy: ";
                cin >> stopien;

                p->setImie(imie);
                p->setNazwisko(nazwisko);
                p->setStanowisko(stanowisko);
                p->setStopien(stopien);

                tab[liczbaOsob++] = p;
            }

            break;
        }

        case 2: //wyswietlanie
        {
            cout << "LISTA" << endl;

            for(int i = 0; i < liczbaOsob; i++)
            {
                tab[i]->drukuj();
            }

            break;
        }

        case 3: //zapis do pliku
        {
            int wybor;

            cout << "1. Zapisz cala liste studentow" << endl;
            cout << "2. Zapisz wybranego studenta" << endl;
            cout << "Wybor: ";

            cin >> wybor;

            ofstream plik("plik.txt");

            if(!plik)
            {
                cout << "Nie mozna otworzyc pliku." << endl;
                break;
            }

            //calosc
            if(wybor == 1)
            {
                for(int i = 0; i < liczbaOsob; i++)
                {
                    ISerializable* obiekt =
                        dynamic_cast<ISerializable*>(tab[i]);

                    if(obiekt != nullptr)
                    {
                        plik << obiekt->serializable() << endl;
                    }
                }

                cout << "Zapisano cala liste." << endl;
            }

            //pojedyncza osoba
            else if(wybor == 2)
            {
                int indeks;

                cout << "Podaj indeks: ";
                cin >> indeks;

                bool znaleziono = false;

                for(int i = 0; i < liczbaOsob; i++)
                {
                    Student* s =
                        dynamic_cast<Student*>(tab[i]);

                    if(s != nullptr && s->getIndeks() == indeks)
                    {
                        plik << s->serializable() << endl;
                        znaleziono = true;
                        break;
                    }
                }

                if(znaleziono)
                    cout << "Student zapisany." << endl;
                else
                    cout << "Nie znaleziono studenta." << endl;
            }

            plik.close();

            break;
        }

        case 4:
        {
            for(int i = 0; i < liczbaOsob; i++){
                delete tab[i];
            }

            return 0;
        }

        default:
        {
            cout << "Nieznana operacja." << endl;
        }

        }

    }

    return 0;
}
